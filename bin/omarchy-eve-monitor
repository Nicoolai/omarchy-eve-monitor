def character_identity(character_id: str, name: str = "") -> dict:
    return {
        "characterId": int(character_id),
        "name": name or f"Character {character_id}",
        "portrait": f"https://images.evetech.net/characters/{character_id}/portrait?size=64",
    }


def queue_snapshot(client: EsiClient, queue: list, force: bool) -> tuple[list, str, int, int]:
    timestamp = now_epoch()
    result = []
    names: dict[int, str] = {}
    for entry in sorted(queue if isinstance(queue, list) else [], key=lambda item: item.get("queue_position", 0)):
        skill_id = int(entry.get("skill_id", 0) or 0)
        if skill_id and skill_id not in names:
            try:
                skill = client.get(f"universe/types/{skill_id}", ttl=604800, authenticated=False, force=force)
                names[skill_id] = str(skill.get("name", ""))
            except MonitorError:
                names[skill_id] = ""
        finish_date = str(entry.get("finish_date", ""))
        start_date = str(entry.get("start_date", ""))
        result.append({
            "queuePosition": int(entry.get("queue_position", 0) or 0),
            "skillId": skill_id,
            "skillName": names.get(skill_id, ""),
            "finishedLevel": int(entry.get("finished_level", 0) or 0),
            "startDate": start_date,
            "finishDate": finish_date,
            "remainingSeconds": max(0, iso_epoch(finish_date) - timestamp),
        })

    active = next((entry for entry in result if entry["finishDate"] and iso_epoch(entry["finishDate"]) > timestamp), None)
    future = [entry for entry in result if entry["finishDate"] and iso_epoch(entry["finishDate"]) > timestamp]
    last_finish = max((iso_epoch(entry["finishDate"]) for entry in future), default=0)
    return result, (active["skillName"] if active else ""), (active["remainingSeconds"] if active else 0), max(0, last_finish - timestamp)


def character_snapshot(character: dict, force: bool, plans: list | None = None) -> dict:
    character_id = str(character.get("character_id", ""))
    client = EsiClient(character)
    output = character_identity(character_id, str(character.get("name", "")))
    output["errors"] = []
    try:
        profile = client.get(f"characters/{character_id}", ttl=86400, authenticated=False, force=force)
        output["corporationId"] = profile.get("corporation_id")
        output["allianceId"] = profile.get("alliance_id")
        output["securityStatus"] = profile.get("security_status")
        corporation_id = profile.get("corporation_id")
        if corporation_id:
            try:
                corporation = client.get(f"corporations/{int(corporation_id)}", ttl=3600, authenticated=False, force=force)
                output["corporationName"] = corporation.get("name", "")
                output["corporationTicker"] = corporation.get("ticker", "")
            except (MonitorError, ValueError):
                output["corporationName"] = ""
        alliance_id = profile.get("alliance_id")
        if alliance_id:
            try:
                alliance = client.get(f"alliances/{int(alliance_id)}", ttl=3600, authenticated=False, force=force)
                output["allianceName"] = alliance.get("name", "")
                output["allianceTicker"] = alliance.get("ticker", "")
            except (MonitorError, ValueError):
                output["allianceName"] = ""
    except MonitorError as error:
        output["errors"].append(f"profile: {error}")

    try:
        skills = client.get(f"characters/{character_id}/skills", ttl=60, force=force)
        output["totalSp"] = int(skills.get("total_sp", 0) or 0)
        output["unallocatedSp"] = int(skills.get("unallocated_sp", 0) or 0)
        output["skills"] = skills.get("skills", [])
    except MonitorError as error:
        output["errors"].append(f"skills: {error}")
        output["skills"] = []

    try:
        queue = client.get(f"characters/{character_id}/skillqueue", ttl=60, force=force)
        output["queue"], output["currentSkillName"], output["remainingSeconds"], output["queueRemainingSeconds"] = queue_snapshot(client, queue, force)
    except MonitorError as error:
        output["errors"].append(f"queue: {error}")
        output["queue"] = []
        output["currentSkillName"] = ""
        output["remainingSeconds"] = 0
        output["queueRemainingSeconds"] = 0

    try:
        attributes = client.get(f"characters/{character_id}/attributes", ttl=120, force=force)
        output["attributes"] = attributes
    except MonitorError as error:
        output["errors"].append(f"attributes: {error}")
        output["attributes"] = {}

    try:
        output["wallet"] = float(client.get(f"characters/{character_id}/wallet", ttl=120, force=force))
    except MonitorError as error:
        output["errors"].append(f"wallet: {error}")
        output["wallet"] = 0

    try:
        online = client.get(f"characters/{character_id}/online", ttl=60, force=force)
        output["online"] = online.get("online") is True
        output["lastLogin"] = online.get("last_login", "")
        output["lastLogout"] = online.get("last_logout", "")
    except MonitorError as error:
        output["errors"].append(f"online: {error}")
        output["online"] = False

    try:
        location = client.get(f"characters/{character_id}/location", ttl=5, force=force)
        output["location"] = location
        solar_system_id = location.get("solar_system_id")
        if solar_system_id:
            try:
                system = client.get(f"universe/systems/{int(solar_system_id)}", ttl=604800, authenticated=False, force=force)
                output["solarSystemName"] = system.get("name", "")
            except (MonitorError, ValueError):
                output["solarSystemName"] = ""
    except MonitorError as error:
        output["errors"].append(f"location: {error}")
        output["location"] = {}

    try:
        ship = client.get(f"characters/{character_id}/ship", ttl=5, force=force)
        output["ship"] = ship
        ship_type_id = ship.get("ship_type_id")
        if ship_type_id:
            try:
                ship_type = client.get(f"universe/types/{int(ship_type_id)}", ttl=604800, authenticated=False, force=force)
                output["shipName"] = ship_type.get("name", "")
            except (MonitorError, ValueError):
                output["shipName"] = ""
    except MonitorError as error:
        output["errors"].append(f"ship: {error}")
        output["ship"] = {}

    output["planEtaSeconds"], output["planError"] = plan_eta(output, plans or [])
    output["error"] = "; ".join(output["errors"])
    del output["errors"]
    character["name"] = output["name"]
    return output


def demo_snapshot() -> dict:
    timestamp = now_epoch()
    def demo_character(character_id: int, name: str, seconds: int, skill: str, online: bool) -> dict:
        finish = datetime.fromtimestamp(timestamp + seconds, timezone.utc).isoformat().replace("+00:00", "Z")
        return {
            **character_identity(str(character_id), name),
            "online": online,
            "totalSp": 112345678 if character_id % 2 else 87654321,
            "unallocatedSp": 0,
            "wallet": 425000000.12 if character_id % 2 else 9125000,
            "currentSkillName": skill,
            "remainingSeconds": seconds,
            "queueRemainingSeconds": seconds + 86400,
            "planEtaSeconds": seconds + 4 * 86400,
            "planError": "",
            "queue": [{"queuePosition": 0, "skillName": skill, "finishedLevel": 5, "finishDate": finish, "remainingSeconds": seconds}],
            "attributes": {"intelligence": 27, "memory": 21, "perception": 24, "willpower": 23, "charisma": 17},
            "error": "",
        }
    return {
        "ok": True,
        "demo": True,
        "generatedAt": timestamp,
        "selectedCharacterId": "90000001",
        "characters": [
            demo_character(90000001, "Demo Capsuleer", 2 * 3600 + 14 * 60, "Advanced Infomorph Psychology", True),
            demo_character(90000002, "Alt Capsuleer", 2 * 86400 + 5 * 3600, "Gallente Battleship", False),
        ],
        "plans": [{"name": "Demo PvE Plan", "skills": [{"skillId": 3355, "targetLevel": 5}]}],
    }


def load_characters() -> dict:
    data = state()
    valid = []
    for character in data["characters"]:
        if isinstance(character, dict) and str(character.get("character_id", "")).isdigit():
            valid.append(character)
    data["characters"] = valid
    return data


def snapshot(force: bool) -> dict:
    if DEMO_FILE.is_file() and not DEMO_FILE.is_symlink():
        return demo_snapshot()
    data = load_characters()
    characters = []
    for character in data["characters"]:
        try:
            characters.append(character_snapshot(character, force, data["plans"]))
        except MonitorError as error:
            identity = character_identity(str(character.get("character_id")), str(character.get("name", "")))
            identity.update({"online": False, "queue": [], "remainingSeconds": 0, "queueRemainingSeconds": 0, "error": str(error)})
            characters.append(identity)
    # Access-token refreshes happen while building the snapshot. Persist the
    # rotated token before the helper exits so the next refresh is seamless.
    write_json(STATE_FILE, data)
    return {
        "ok": True,
        "generatedAt": now_epoch(),
        "selectedCharacterId": str(data.get("selectedCharacterId", "")),
        "characters": characters,
        "plans": data["plans"],
    }


def pkce_pair() -> tuple[str, str]:
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip("=")
    digest = hashlib.sha256(verifier.encode()).digest()
    challenge = base64.urlsafe_b64encode(digest).decode().rstrip("=")
    return verifier, challenge


SCOPES = [
    "esi-skills.read_skills.v1", "esi-skills.read_skillqueue.v1",
    "esi-wallet.read_character_wallet.v1", "esi-assets.read_assets.v1",
    "esi-location.read_location.v1", "esi-location.read_online.v1", "esi-location.read_ship_type.v1",
    "esi-clones.read_clones.v1", "esi-clones.read_implants.v1", "esi-characters.read_standings.v1",
    "esi-universe.read_structures.v1",
    "esi-contracts.read_character_contracts.v1", "esi-industry.read_character_jobs.v1",
    "esi-industry.read_character_mining.v1", "esi-markets.read_character_orders.v1",
    "esi-planets.manage_planets.v1", "esi-characters.read_blueprints.v1",
    "esi-characters.read_agents_research.v1", "esi-characters.read_fatigue.v1",
    "esi-characters.read_loyalty.v1", "esi-characters.read_corporation_roles.v1",
    "esi-characters.read_titles.v1", "esi-characters.read_medals.v1", "esi-fittings.read_fittings.v1",
    "esi-killmails.read_killmails.v1", "esi-characters.read_notifications.v1",
    "esi-mail.read_mail.v1", "esi-calendar.read_calendar_events.v1",
]


def auth_add() -> dict:
    cid = client_id()
    if not cid:
        raise MonitorError("configure a client ID before authorizing")
    redirect_uri = str(config().get("redirect_uri", DEFAULT_REDIRECT_URI))
    parsed_redirect = urllib.parse.urlparse(redirect_uri)
    if parsed_redirect.scheme != "http" or parsed_redirect.hostname not in ("127.0.0.1", "localhost"):
        raise MonitorError("redirect_uri must be an http loopback URL")
    verifier, challenge = pkce_pair()
    state_token = secrets.token_urlsafe(24)
    query = urllib.parse.urlencode({
        "response_type": "code", "client_id": cid, "redirect_uri": redirect_uri,
        "scope": " ".join(SCOPES), "state": state_token,
        "code_challenge": challenge, "code_challenge_method": "S256",
    })

    result: dict = {}
    class CallbackHandler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:  # noqa: N802
            request = urllib.parse.urlparse(self.path)
            params = urllib.parse.parse_qs(request.query)
            if request.path != urllib.parse.urlparse(redirect_uri).path:
                self.send_error(404)
                return
            result.update({key: values[0] for key, values in params.items() if values})
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(b"EVE authorization received. You can close this tab.\n")

        def log_message(self, format: str, *args: object) -> None:
            return

    redirect_host = parsed_redirect.hostname or "127.0.0.1"
    server = HTTPServer((redirect_host, parsed_redirect.port or 80), CallbackHandler)
    server.timeout = 1
    try:
        subprocess.Popen(["xdg-open", f"{SSO_AUTHORIZE}?{query}"])
        deadline = time.monotonic() + 120
        while time.monotonic() < deadline and not result:
            server.handle_request()
    finally:
        server.server_close()
    if result.get("state") != state_token:
        raise MonitorError("authorization state did not match")
    if result.get("error"):
        raise MonitorError(result.get("error_description") or result["error"])
    if not result.get("code"):
        raise MonitorError("authorization timed out")
    body = urllib.parse.urlencode({
        "grant_type": "authorization_code", "code": result["code"],
        "client_id": cid, "redirect_uri": redirect_uri, "code_verifier": verifier,
    }).encode()
    token, _ = json_request(SSO_TOKEN, method="POST", data=body, headers={
        "Content-Type": "application/x-www-form-urlencoded",
    })
    access = str(token.get("access_token", ""))
    if not access:
        raise MonitorError("authorization returned no access token")
    identity, _ = json_request(SSO_VERIFY, headers={"Authorization": f"Bearer {access}"})
    character_id = str(identity.get("CharacterID", ""))
    character_name = str(identity.get("CharacterName", ""))
    if not character_id.isdigit() or not character_name:
        raise MonitorError("EVE did not return a character identity")
    data = load_characters()
    existing = next((item for item in data["characters"] if str(item.get("character_id")) == character_id), None)
    record = existing or {"character_id": character_id}
    record.update({
        "name": character_name,
        "access_token": access,
        "refresh_token": str(token.get("refresh_token", record.get("refresh_token", ""))),
        "expires_at": now_epoch() + int(token.get("expires_in", 1200) or 1200),
        "scopes": identity.get("Scopes", []),
    })
    if existing is None:
        data["characters"].append(record)
    if not data.get("selectedCharacterId"):
        data["selectedCharacterId"] = character_id
    write_json(STATE_FILE, data)
    return {"ok": True, "characterId": int(character_id), "name": character_name}


def main() -> None:
    private_directory(ROOT)
    private_directory(CACHE_ROOT)
    command = sys.argv[1] if len(sys.argv) > 1 else "snapshot"
    try:
        if command == "snapshot":
            emit(snapshot("--force" in sys.argv[2:]))
        if command == "details":
            character_id = sys.argv[2] if len(sys.argv) > 2 else ""
            feature = sys.argv[3] if len(sys.argv) > 3 else ""
            if not character_id.isdigit():
                raise MonitorError("details requires a numeric character id")
            if DEMO_FILE.is_file() and not DEMO_FILE.is_symlink():
                emit(demo_detail(feature))
            data = load_characters()
            character = next((item for item in data["characters"] if str(item.get("character_id")) == character_id), None)
            if character is None:
                raise MonitorError("character is not connected")
            emit(detail_snapshot(character, feature, "--force" in sys.argv[4:]))
        if command == "auth-add":
            emit(auth_add())
        if command == "auth-list":
            data = load_characters()
            emit({"ok": True, "characters": [character_identity(str(item["character_id"]), item.get("name", "")) for item in data["characters"]]})
        if command == "auth-remove":
            character_id = sys.argv[2] if len(sys.argv) > 2 else ""
            if not character_id.isdigit():
                raise MonitorError("character id must be numeric")
            data = load_characters()
            data["characters"] = [item for item in data["characters"] if str(item.get("character_id")) != character_id]
            if str(data.get("selectedCharacterId")) == character_id:
                data["selectedCharacterId"] = str(data["characters"][0]["character_id"]) if data["characters"] else ""
            write_json(STATE_FILE, data)
            emit({"ok": True})
        if command == "select":
            character_id = sys.argv[2] if len(sys.argv) > 2 else ""
            data = load_characters()
            if not any(str(item.get("character_id")) == character_id for item in data["characters"]):
                raise MonitorError("character is not connected")
            data["selectedCharacterId"] = character_id
            write_json(STATE_FILE, data)
            emit({"ok": True})
        if command == "demo":
            action = sys.argv[2] if len(sys.argv) > 2 else ""
            if action == "on":
                private_directory(DEMO_FILE.parent)
                DEMO_FILE.write_text("demo\n", encoding="utf-8")
                DEMO_FILE.chmod(0o600)
            elif action == "off":
                DEMO_FILE.unlink(missing_ok=True)
            else:
                raise MonitorError("demo takes on or off")
            emit({"ok": True, "demo": action == "on"})
        if command == "plan-list":
            emit({"ok": True, "plans": load_characters()["plans"]})
        if command == "plan-add":
            if len(sys.argv) < 5 or not sys.argv[3].isdigit() or not sys.argv[4].isdigit():
                raise MonitorError("plan-add requires name, numeric skill id, and level")
            data = load_characters()
            name = sys.argv[2].strip()[:80]
            if not name:
                raise MonitorError("plan name cannot be empty")
            level = max(1, min(5, int(sys.argv[4])))
            plan = next((item for item in data["plans"] if item.get("name") == name), None)
            if plan is None:
                plan = {"name": name, "skills": []}
                data["plans"].append(plan)
            plan["skills"].append({"skillId": int(sys.argv[3]), "targetLevel": level})
            write_json(STATE_FILE, data)
            emit({"ok": True, "plans": data["plans"]})
        if command == "catalog-update":
            emit(update_catalog())
        raise MonitorError(f"unknown command: {command}")
    except MonitorError as error:
        emit({"ok": False, "error": str(error)})
    except (OSError, ValueError, KeyError) as error:
        emit({"ok": False, "error": str(error)})


if __name__ == "__main__":
    main()
