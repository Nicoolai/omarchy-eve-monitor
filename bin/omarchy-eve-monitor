#!/usr/bin/env python3
"""Small, dependency-free EVE Online ESI client for the Omarchy widget.

The command prints one JSON document and exits. Credentials are kept in the
private config directory and are never accepted as command-line arguments.
"""

from __future__ import annotations

import base64
import hashlib
import json
import math
import os
import secrets
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path


APP_NAME = "omarchy-eve-monitor"
ESI_BASE = "https://esi.evetech.net/latest"
SSO_AUTHORIZE = "https://login.eveonline.com/v2/oauth/authorize"
SSO_TOKEN = "https://login.eveonline.com/v2/oauth/token"
SSO_VERIFY = "https://login.eveonline.com/v2/oauth/verify"
DEFAULT_CLIENT_ID = "60d5e8746337487c92d926c75a63f8bd"
DEFAULT_REDIRECT_URI = "http://127.0.0.1:48173/callback"
USER_AGENT = "EVEOnlineMonitor/0.1.0 (+https://github.com/nicoolai/omarchy-eve-monitor)"

ROOT = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / APP_NAME
CACHE_ROOT = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / APP_NAME
CONFIG_FILE = ROOT / "config.json"
STATE_FILE = ROOT / "state.json"
DEMO_FILE = CACHE_ROOT / "demo"
CATALOG_FILE = CACHE_ROOT / "skill-catalog.json"
SDE_URL = "https://developers.eveonline.com/static-data/eve-online-static-data-latest-jsonl.zip"


class MonitorError(Exception):
    pass


def emit(payload: dict, exit_code: int = 0) -> None:
    print(json.dumps(payload, separators=(",", ":"), ensure_ascii=True))
    raise SystemExit(exit_code)


def private_directory(path: Path) -> None:
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    if path.is_symlink() or not path.is_dir():
        raise MonitorError(f"private directory is not usable: {path}")
    try:
        path.chmod(0o700)
    except OSError as error:
        raise MonitorError(f"cannot secure {path}: {error}") from error


def safe_read_json(path: Path, fallback: dict) -> dict:
    if path.is_symlink() or not path.is_file():
        return dict(fallback)
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else dict(fallback)
    except (OSError, ValueError):
        return dict(fallback)


def write_json(path: Path, payload: dict) -> None:
    private_directory(path.parent)
    if path.is_symlink():
        raise MonitorError(f"refusing to overwrite symlink: {path}")
    contents = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(contents)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.chmod(0o600)
        temporary.replace(path)
    except BaseException:
        temporary.unlink(missing_ok=True)
        raise


def config() -> dict:
    return safe_read_json(CONFIG_FILE, {
        "client_id": DEFAULT_CLIENT_ID,
        "redirect_uri": DEFAULT_REDIRECT_URI,
    })


def state() -> dict:
    data = safe_read_json(STATE_FILE, {
        "selectedCharacterId": "",
        "characters": [],
        "plans": [],
    })
    if not isinstance(data.get("characters"), list):
        data["characters"] = []
    if not isinstance(data.get("plans"), list):
        data["plans"] = []
    return data


def client_id() -> str:
    override = os.environ.get("OMARCHY_EVE_CLIENT_ID", "").strip()
    configured = str(config().get("client_id", "")).strip()
    return override or configured or DEFAULT_CLIENT_ID


def now_epoch() -> int:
    return int(time.time())


def iso_epoch(value: object) -> int:
    if not value:
        return 0
    try:
        text = str(value).replace("Z", "+00:00")
        return int(datetime.fromisoformat(text).timestamp())
    except (TypeError, ValueError, OverflowError):
        return 0


def skill_points_for_level(rank: int, level: int) -> int:
    """Return the game's cumulative SP threshold without float drift."""
    rank = max(1, int(rank))
    level = max(0, min(5, int(level)))
    if level == 0:
        return 0
    # The client uses the game's nearest-integer thresholds. Rounding also
    # avoids a binary-float artifact turning the exact level-five value of
    # 256000 into 256001.
    return int(round(250 * rank * math.sqrt(32) ** (level - 1)))


def load_catalog() -> dict:
    data = safe_read_json(CATALOG_FILE, {"skills": {}})
    return data if isinstance(data.get("skills"), dict) else {"skills": {}}


def catalog_records(archive: zipfile.ZipFile, filename: str) -> list[dict]:
    entry = next((name for name in archive.namelist() if name.endswith("/" + filename) or name == filename), None)
    if not entry:
        raise MonitorError(f"SDE archive is missing {filename}")
    records = []
    with archive.open(entry) as stream:
        for raw in stream:
            try:
                record = json.loads(raw.decode("utf-8"))
            except (UnicodeDecodeError, ValueError):
                continue
            if isinstance(record, dict):
                records.append(record)
    return records


def update_catalog() -> dict:
    private_directory(CACHE_ROOT)
    descriptor, temporary_name = tempfile.mkstemp(prefix="sde.", dir=CACHE_ROOT)
    os.close(descriptor)
    temporary = Path(temporary_name)
    try:
        request = urllib.request.Request(SDE_URL, headers={"User-Agent": USER_AGENT})
        with urllib.request.urlopen(request, timeout=60) as response, temporary.open("wb") as target:
            shutil.copyfileobj(response, target)
        with zipfile.ZipFile(temporary) as archive:
            groups = {
                int(record["_key"]): (record.get("name", {}).get("en", "") if isinstance(record.get("name"), dict) else str(record.get("name", "")))
                for record in catalog_records(archive, "groups.jsonl")
                if record.get("categoryID") == 16 and str(record.get("_key", "")).isdigit()
            }
            types = {
                int(record["_key"]): record
                for record in catalog_records(archive, "types.jsonl")
                if record.get("groupID") in groups and record.get("published") is True
                and str(record.get("_key", "")).isdigit()
            }
            dogma = {
                int(record["_key"]): record
                for record in catalog_records(archive, "typeDogma.jsonl")
                if str(record.get("_key", "")).isdigit()
            }
        skills = {}
        for skill_id, record in types.items():
            attributes = {
                int(item["attributeID"]): item.get("value")
                for item in dogma.get(skill_id, {}).get("dogmaAttributes", [])
                if str(item.get("attributeID", "")).isdigit()
            }
            name = record.get("name", "")
            if isinstance(name, dict):
                name = name.get("en", "")
            requirements = []
            for skill_slot in (1, 2, 3):
                required_id = attributes.get(181 + skill_slot)
                required_level = attributes.get(276 + skill_slot)
                if required_id is not None and required_level is not None:
                    requirements.append({"skillId": int(required_id), "level": int(required_level)})
            skills[str(skill_id)] = {
                "name": str(name),
                "rank": int(attributes.get(275, 1) or 1),
                "primary": int(attributes.get(180, 166) or 166),
                "secondary": int(attributes.get(181, 165) or 165),
                "group": str(groups.get(int(record.get("groupID", 0) or 0), "Uncategorized")),
                "requirements": requirements,
            }
        payload = {"source": SDE_URL, "updatedAt": now_epoch(), "skills": skills}
        write_json(CATALOG_FILE, payload)
        return {"ok": True, "skills": len(skills), "path": str(CATALOG_FILE)}
    except (OSError, urllib.error.URLError, zipfile.BadZipFile, KeyError, ValueError) as error:
        raise MonitorError(f"could not update skill catalog: {error}") from error
    finally:
        temporary.unlink(missing_ok=True)


def expanded_plan(skills: list, catalog: dict) -> dict[int, int]:
    expanded: dict[int, int] = {}

    def add(skill_id: int, level: int, active: set[int]) -> None:
        if skill_id in active:
            return
        expanded[skill_id] = max(level, expanded.get(skill_id, 0))
        metadata = catalog.get("skills", {}).get(str(skill_id), {})
        next_active = active | {skill_id}
        for requirement in metadata.get("requirements", []):
            add(int(requirement["skillId"]), int(requirement["level"]), next_active)

    for item in skills if isinstance(skills, list) else []:
        if str(item.get("skillId", "")).isdigit():
            add(int(item["skillId"]), max(1, min(5, int(item.get("targetLevel", 1)))), set())
    return expanded


def plan_eta(character_output: dict, plans: list) -> tuple[int | None, str]:
    applicable = [plan for plan in plans if not plan.get("characterId") or str(plan.get("characterId")) == str(character_output.get("characterId"))]
    if not applicable:
        return 0, ""
    catalog = load_catalog()
    if not catalog.get("skills"):
        return None, "Skill catalog not installed; run: python3 bin/omarchy-eve-monitor catalog-update"
    current = {
        str(item.get("skill_id")): int(item.get("skillpoints_in_skill", 0) or 0)
        for item in character_output.get("skills", [])
    }
    attributes = character_output.get("attributes", {})
    total_seconds = 0.0
    for plan in applicable:
        targets = expanded_plan(plan.get("skills", []), catalog)
        for skill_id, level in targets.items():
            metadata = catalog["skills"].get(str(skill_id))
            if not metadata:
                continue
            required = skill_points_for_level(metadata["rank"], level)
            remaining = max(0, required - current.get(str(skill_id), 0))
            primary = {164: "charisma", 165: "intelligence", 166: "memory", 167: "perception", 168: "willpower"}.get(metadata["primary"], "intelligence")
            secondary = {164: "charisma", 165: "intelligence", 166: "memory", 167: "perception", 168: "willpower"}.get(metadata["secondary"], "memory")
            rate = float(attributes.get(primary, 20) or 20) + float(attributes.get(secondary, 20) or 20) / 2
            if rate > 0:
                total_seconds += remaining / rate * 60
    # Do not turn an exact whole-second estimate into the next second because
    # of binary floating-point representation.
    return max(0, int(math.ceil(total_seconds - 1e-9))), ""


def json_request(url: str, *, method: str = "GET", data: bytes | None = None,
                 headers: dict[str, str] | None = None, timeout: int = 15) -> tuple[dict | list, dict]:
    request = urllib.request.Request(url, data=data, method=method)
    for key, value in (headers or {}).items():
        request.add_header(key, value)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read()
            return json.loads(raw.decode("utf-8")), dict(response.headers.items())
    except urllib.error.HTTPError as error:
        body = error.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(body)
        except ValueError:
            detail = {}
        raise MonitorError(f"HTTP {error.code}: {detail.get('error_description') or detail.get('error') or error.reason}") from error
    except (urllib.error.URLError, TimeoutError, ValueError) as error:
        raise MonitorError(f"network request failed: {error}") from error


def cache_path(character_id: str, key: str) -> Path:
    if not character_id.isdigit():
        raise MonitorError("invalid character id")
    safe_key = "".join(char if char.isalnum() else "_" for char in key)
    return CACHE_ROOT / character_id / f"{safe_key}.json"


def cached_payload(character_id: str, key: str) -> dict | None:
    path = cache_path(character_id, key)
    data = safe_read_json(path, {})
    return data if "payload" in data else None


class EsiClient:
    def __init__(self, character: dict):
        self.character = character

    def access_token(self) -> str:
        token = str(self.character.get("access_token", ""))
        expires = int(self.character.get("expires_at", 0) or 0)
        if token and expires > now_epoch() + 60:
            return token
        refresh = str(self.character.get("refresh_token", ""))
        if not refresh:
            raise MonitorError("character authorization has expired")
        cid = client_id()
        if not cid:
            raise MonitorError("client_id is not configured")
        body = urllib.parse.urlencode({
            "grant_type": "refresh_token",
            "refresh_token": refresh,
            "client_id": cid,
        }).encode()
        payload, _ = json_request(SSO_TOKEN, method="POST", data=body, headers={
            "Content-Type": "application/x-www-form-urlencoded",
        })
        self.character["access_token"] = str(payload.get("access_token", ""))
        self.character["expires_at"] = now_epoch() + int(payload.get("expires_in", 1200) or 1200)
        if payload.get("refresh_token"):
            self.character["refresh_token"] = payload["refresh_token"]
        if not self.character["access_token"]:
            raise MonitorError("token refresh returned no access token")
        return self.character["access_token"]

    def get(self, path: str, *, ttl: int, authenticated: bool = True,
            force: bool = False) -> dict | list:
        character_id = str(self.character.get("character_id", "0"))
        key = path.strip("/").replace("/", "_")
        cached = cached_payload(character_id, key)
        fetched = int(cached.get("fetched_at", 0)) if cached else 0
        if cached and not force and now_epoch() - fetched < ttl:
            return cached["payload"]

        headers = {"User-Agent": USER_AGENT, "X-Compatibility-Date": "2026-08-27"}
        if cached and cached.get("etag"):
            headers["If-None-Match"] = str(cached["etag"])
        if cached and cached.get("last_modified"):
            headers["If-Modified-Since"] = str(cached["last_modified"])
        if authenticated:
            headers["Authorization"] = f"Bearer {self.access_token()}"

        url = ESI_BASE + "/" + path.strip("/")
        try:
            payload, response_headers = json_request(url, headers=headers)
        except MonitorError as error:
            if authenticated and "HTTP 401" in str(error):
                # A revoked token can fail before its local expiry. Clear it so
                # access_token() performs one refresh, then retry once.
                self.character["access_token"] = ""
                self.character["expires_at"] = 0
                headers["Authorization"] = f"Bearer {self.access_token()}"
                payload, response_headers = json_request(url, headers=headers)
            elif "HTTP 304" in str(error) and cached:
                cached["fetched_at"] = now_epoch()
                write_json(cache_path(character_id, key), cached)
                return cached["payload"]
            else:
                raise

        envelope = {
            "fetched_at": now_epoch(),
            "payload": payload,
            "etag": response_headers.get("ETag", cached.get("etag", "") if cached else ""),
            "last_modified": response_headers.get("Last-Modified", cached.get("last_modified", "") if cached else ""),
        }
        write_json(cache_path(character_id, key), envelope)
        return payload


def public_names(ids: list[int]) -> dict[str, str]:
    unique = sorted({int(value) for value in ids if str(value).isdigit()})[:1000]
    if not unique:
        return {}
    body = json.dumps(unique, separators=(",", ":")).encode()
    payload, _ = json_request(ESI_BASE + "/universe/names", method="POST", data=body, headers={
        "Content-Type": "application/json",
        "User-Agent": USER_AGENT,
        "X-Compatibility-Date": "2026-08-27",
    })
    return {str(item["id"]): str(item["name"]) for item in payload if isinstance(item, dict) and "id" in item}


def resolve_location_names(client: EsiClient, ids: list, force: bool) -> dict[str, str]:
    unique = sorted({int(value) for value in ids if str(value).isdigit()})
    if not unique:
        return {}
    try:
        names = public_names(unique)
    except MonitorError:
        names = {}
    for location_id in unique:
        key = str(location_id)
        if key in names:
            continue
        try:
            names.update(public_names([location_id]))
        except MonitorError:
            try:
                structure = client.get(f"universe/structures/{location_id}", ttl=604800, force=force)
                if isinstance(structure, dict) and structure.get("name"):
                    names[key] = str(structure["name"])
            except MonitorError:
                pass
    return names


def paged(client: EsiClient, path: str, *, force: bool = False, max_pages: int = 20) -> list:
    records = []
    for page in range(1, max_pages + 1):
        payload = client.get(f"{path}?page={page}", ttl=3600, force=force)
        if not isinstance(payload, list):
            break
        records.extend(payload)
        if len(payload) < 1000:
            break
    return records


def collect_feature(client: EsiClient, key: str, loader, output: dict, errors: list[str]) -> None:
    try:
        output[key] = loader()
    except MonitorError as error:
        errors.append(f"{key}: {error}")
        output[key] = [] if key.endswith("s") else {}


def wallet_cashflow(journal: list) -> dict:
    income = 0.0
    expenses = 0.0
    by_day: dict[str, dict[str, float]] = {}
    for entry in journal if isinstance(journal, list) else []:
        if not isinstance(entry, dict):
            continue
        try:
            amount = float(entry.get("amount", 0) or 0)
        except (TypeError, ValueError):
            continue
        if amount >= 0:
            income += amount
        else:
            expenses += abs(amount)
        day = str(entry.get("date", ""))[:10]
        if len(day) != 10:
            continue
        bucket = by_day.setdefault(day, {"income": 0.0, "expenses": 0.0})
        if amount >= 0:
            bucket["income"] += amount
        else:
            bucket["expenses"] += abs(amount)
    days = [{"date": day, **values} for day, values in sorted(by_day.items())]
    return {"income": income, "expenses": expenses, "net": income - expenses, "days": days}


def detail_snapshot(character: dict, feature: str, force: bool) -> dict:
    character_id = str(character.get("character_id", ""))
    groups = {
        "training": ["skills"],
        "wealth": ["wallet"],
        "industry_market": ["industry", "market"],
    }
    if feature in groups:
        data: dict = {}
        errors: list[str] = []
        for child in groups[feature]:
            result = detail_snapshot(character, child, force)
            data.update(result["data"])
            errors.extend(result["errors"])
        return {"ok": True, "characterId": int(character_id), "feature": feature, "data": data, "errors": errors}

    client = EsiClient(character)
    data: dict = {}
    errors: list[str] = []
    prefix = f"characters/{character_id}"

    if feature == "skills":
        skills = client.get(f"{prefix}/skills", ttl=60, force=force)
        catalog = load_catalog().get("skills", {})
        skill_ids = [int(item.get("skill_id", 0)) for item in skills.get("skills", []) if str(item.get("skill_id", "")).isdigit()]
        names = {skill_id: catalog.get(str(skill_id), {}).get("name", "") for skill_id in skill_ids}
        missing = [skill_id for skill_id in skill_ids if not names.get(skill_id)]
        try:
            names.update({int(key): value for key, value in public_names(missing).items()})
        except MonitorError:
            pass
        data = {
            "totalSp": skills.get("total_sp", 0),
            "unallocatedSp": skills.get("unallocated_sp", 0),
            "skills": [{
                **item,
                "name": names.get(int(item.get("skill_id", 0)), "Unknown skill"),
                "category": catalog.get(str(item.get("skill_id", 0)), {}).get("group", "Uncategorized"),
            } for item in skills.get("skills", [])],
        }
    elif feature == "wallet":
        collect_feature(client, "wallet", lambda: client.get(f"{prefix}/wallet", ttl=120, force=force), data, errors)
        collect_feature(client, "journal", lambda: paged(client, f"{prefix}/wallet/journal", force=force), data, errors)
        data["cashflow"] = wallet_cashflow(data.get("journal", []))
    elif feature == "assets":
        assets = paged(client, f"{prefix}/assets", force=force)
        ids = [int(item.get("type_id", 0)) for item in assets if str(item.get("type_id", "")).isdigit()]
        ids += [int(item.get("location_id", 0)) for item in assets if str(item.get("location_id", "")).isdigit()]
        try:
            names = public_names(ids)
        except MonitorError:
            names = {}
        data["assets"] = [{**item, "typeName": names.get(str(item.get("type_id")), "Unknown type"), "locationName": names.get(str(item.get("location_id")), "Unknown location")} for item in assets]
    elif feature == "industry":
        collect_feature(client, "jobs", lambda: client.get(f"{prefix}/industry/jobs", ttl=300, force=force), data, errors)
        collect_feature(client, "blueprints", lambda: paged(client, f"{prefix}/blueprints", force=force), data, errors)
        collect_feature(client, "planets", lambda: client.get(f"{prefix}/planets", ttl=600, force=force), data, errors)
        collect_feature(client, "mining", lambda: paged(client, f"{prefix}/mining", force=force), data, errors)
        collect_feature(client, "research", lambda: client.get(f"{prefix}/agents_research", ttl=3600, force=force), data, errors)
    elif feature == "market":
        collect_feature(client, "orders", lambda: client.get(f"{prefix}/orders", ttl=1200, force=force), data, errors)
        collect_feature(client, "orderHistory", lambda: paged(client, f"{prefix}/orders/history", force=force), data, errors)
        collect_feature(client, "contracts", lambda: paged(client, f"{prefix}/contracts", force=force), data, errors)
    elif feature == "activity":
        collect_feature(client, "notifications", lambda: client.get(f"{prefix}/notifications", ttl=600, force=force), data, errors)
        collect_feature(client, "mail", lambda: client.get(f"{prefix}/mail", ttl=30, force=force), data, errors)
        collect_feature(client, "calendar", lambda: client.get(f"{prefix}/calendar", ttl=5, force=force), data, errors)
        collect_feature(client, "killmails", lambda: paged(client, f"{prefix}/killmails/recent", force=force), data, errors)
    elif feature == "character":
        collect_feature(client, "clones", lambda: client.get(f"{prefix}/clones", ttl=120, force=force), data, errors)
        try:
            implants = client.get(f"{prefix}/implants", ttl=120, force=force)
            implant_ids = [
                int(item.get("type_id", 0)) if isinstance(item, dict) else int(item)
                for item in implants
                if (isinstance(item, dict) and str(item.get("type_id", "")).isdigit()) or (not isinstance(item, dict) and str(item).isdigit())
            ]
            try:
                names = public_names(implant_ids)
            except MonitorError:
                names = {}
            data["implants"] = [{
                "typeId": implant_id,
                "name": names.get(str(implant_id), "Implant type " + str(implant_id)),
            } for implant_id in implant_ids]
        except MonitorError as error:
            errors.append(f"implants: {error}")
            data["implants"] = []
        collect_feature(client, "fatigue", lambda: client.get(f"{prefix}/fatigue", ttl=300, force=force), data, errors)
        collect_feature(client, "standings", lambda: client.get(f"{prefix}/standings", ttl=3600, force=force), data, errors)
        collect_feature(client, "loyalty", lambda: client.get(f"{prefix}/loyalty/points", ttl=3600, force=force), data, errors)
        collect_feature(client, "roles", lambda: client.get(f"{prefix}/roles", ttl=3600, force=force), data, errors)
        collect_feature(client, "titles", lambda: client.get(f"{prefix}/titles", ttl=3600, force=force), data, errors)
        collect_feature(client, "medals", lambda: client.get(f"{prefix}/medals", ttl=3600, force=force), data, errors)
        collect_feature(client, "fittings", lambda: client.get(f"{prefix}/fittings", ttl=300, force=force), data, errors)
        location_ids = []
        entity_ids = []
        clones = data.get("clones", {})
        if isinstance(clones, dict):
            home = clones.get("home_location", {})
            if isinstance(home, dict): location_ids.append(home.get("location_id"))
            for clone in clones.get("jump_clones", []):
                if isinstance(clone, dict): location_ids.append(clone.get("location_id"))
        for standing in data.get("standings", []):
            if isinstance(standing, dict): entity_ids.append(standing.get("from_id"))
        for points in data.get("loyalty", []):
            if isinstance(points, dict): entity_ids.append(points.get("corporation_id"))
        location_names = resolve_location_names(client, location_ids, force)
        try:
            entity_names = public_names(entity_ids)
        except MonitorError:
            entity_names = {}
        if isinstance(clones, dict):
            home = clones.get("home_location")
            if isinstance(home, dict):
                home = dict(home)
                home["locationName"] = location_names.get(str(home.get("location_id")), "")
            jump_clones = []
            for clone in clones.get("jump_clones", []):
                if not isinstance(clone, dict): continue
                enriched = dict(clone)
                enriched["locationName"] = location_names.get(str(clone.get("location_id")), "")
                jump_clones.append(enriched)
            data["clones"] = {**clones, "home_location": home or {}, "jump_clones": jump_clones}
        data["standings"] = [{**item, "fromName": entity_names.get(str(item.get("from_id")), "")} for item in data.get("standings", []) if isinstance(item, dict)]
        data["loyalty"] = [{**item, "corporationName": entity_names.get(str(item.get("corporation_id")), "")} for item in data.get("loyalty", []) if isinstance(item, dict)]
    else:
        raise MonitorError("unknown detail feature")
    return {"ok": True, "characterId": int(character_id), "feature": feature, "data": data, "errors": errors}


